#!/bin/sh
set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

echo "=== Pre-commit (fast guard) ==="

STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)

if [ -n "$STAGED_RS" ]; then
  # Fast guard only: this hook never compiles and never runs a heavy gate.
  # `rustfmt` parses and formats, it does not build the crate. Quality proof
  # (clippy, tests, `prview gate`) lives in required CI and in an explicitly
  # invoked `make check` on a dedicated host.
  #
  # Check-only: never mutate or stage files from a hook. Auto-formatting and
  # `git add` here would silently pull a developer's unstaged changes into the
  # commit when a file is only partially staged. Fail loudly and let the
  # developer format and re-stage on purpose.
  if command -v rustfmt >/dev/null 2>&1; then
    EDITION=$(sed -n 's/^edition[[:space:]]*=[[:space:]]*"\([0-9][0-9]*\)".*/\1/p' Cargo.toml | head -n 1)
    [ -n "$EDITION" ] || EDITION=2024

    echo "Checking formatting (rustfmt --check --edition $EDITION)..."
    # Word-splitting is intentional: STAGED_RS is a newline-separated file list
    # and each path is passed to rustfmt as a separate --check target.
    # shellcheck disable=SC2086
    rustfmt --check --edition "$EDITION" $STAGED_RS || {
      echo "Formatting issues found. Run: cargo fmt --all, then re-stage the changes before committing."
      exit 1
    }
  else
    echo "rustfmt not found; skipping the local formatting guard."
    echo "Formatting is enforced in CI (cargo fmt --all -- --check)."
  fi
fi

echo "Pre-commit guard passed."
